# Copy these values into your hosting provider's secret/environment settings.
# Never commit the completed production file.
APP_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-at-least-32-random-characters

# Use the Supabase session-pooler URI and keep SSL enabled.
DATABASE_URL=postgresql+psycopg://postgres.project-ref:replace-database-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
REDIS_URL=redis://redis:6379/0
AUTO_MIGRATE=false

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-strong-unique-password

PUBLIC_BASE_URL=https://store.your-domain.example
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true

# This must be an absolute path on a persistent mounted disk/volume.
PRIVATE_UPLOAD_ROOT=/data/appora/uploads

SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-smtp-user
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_USE_TLS=true

# Install ClamAV in the web/worker image and update signatures with freshclam.
CLAMAV_COMMAND=/usr/bin/clamscan
CLAMAV_TIMEOUT_SECONDS=180

POLICY_VERSION=2026-09-24
LEGAL_OPERATOR_NAME=Your registered business name
LEGAL_ADDRESS=Your complete registered postal address
SUPPORT_EMAIL=support@your-domain.example
PRIVACY_EMAIL=privacy@your-domain.example
GRIEVANCE_OFFICER_NAME=Full name of appointed grievance officer
GRIEVANCE_EMAIL=grievance@your-domain.example
