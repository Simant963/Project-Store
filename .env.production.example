# Copy these values into your hosting provider's secret/environment settings.
# Never commit the completed production file.
APP_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-at-least-32-random-characters

POSTGRES_DB=appora
POSTGRES_USER=appora_user
POSTGRES_PASSWORD=replace-database-password
DATABASE_URL=postgresql+psycopg://appora_user:replace-database-password@db:5432/appora
AUTO_MIGRATE=false

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-strong-unique-password

PUBLIC_BASE_URL=https://store.your-domain.example
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true

# This must be an absolute path on a persistent mounted disk/volume.
PRIVATE_UPLOAD_ROOT=/data/appora/uploads

SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=replace-smtp-user
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_USE_TLS=true

# Install ClamAV in the web/worker image and update signatures with freshclam.
CLAMAV_COMMAND=/usr/bin/clamscan
CLAMAV_TIMEOUT_SECONDS=180
